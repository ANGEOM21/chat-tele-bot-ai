# ========================================================
# TELEGRAM BOT AI CONFIGURATION (Asisten AI Angeom)
# ========================================================

# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=asangeom_bot

# Whitelist Telegram ID Pemilik
OWNER_TELEGRAM_ID=
OWNER_USERNAME=angeom,fahmi

# AI API Keys
GROQ_API=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Workspace OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://angeom-assistant.vercel.app/oauth2callback

# Memory Database Encryption Key (AES-256-GCM 32-byte Key)
MEMORY_ENCRYPTION_KEY=your_encryption_key_32_bytes_here

# Server Settings
PORT=5000
BASE_URL=http://localhost:5000
